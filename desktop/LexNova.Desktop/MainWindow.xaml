<Window x:Class="LexNova.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lex Nova | دستیار حقوقدان" Height="900" Width="1440" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
  <Grid Background="#F4F1EA">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Background="#0C1E33" Padding="18,0">
      <DockPanel LastChildFill="False" VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Right" Text="Lex Nova" Foreground="#CBB48A" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Right" Text="  ·  دستیار حقوقدان" Foreground="#F4F1EA" Opacity=".82" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Left" Click="Refresh_Click" Padding="12,5" Background="Transparent" BorderBrush="#CBB48A" Foreground="#F4F1EA" Content="بازخوانی" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Browser" />
      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F4F1EA" Padding="48">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Lex Nova باز نشد" FontSize="24" FontWeight="SemiBold" Foreground="#0C1E33" TextAlignment="Center" />
          <TextBlock Margin="0,12,0,20" TextWrapping="Wrap" Foreground="#6B6458" TextAlignment="Center" Text="پوشهٔ Web باید کنار برنامه باشد. اگر این پیام ادامه داشت، نسخهٔ کامل برنامه را دوباره دریافت کنید." />
          <Button Click="Retry_Click" HorizontalAlignment="Center" Padding="18,8" Content="تلاش دوباره" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
